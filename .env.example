# 火山引擎方舟 API Key（控制台 → API Key 管理，所有模型共用）
VOLC_API_KEY=your-ark-api-key

# 识酒视觉模型接入点（须支持 image_url 多模态，推荐豆包 Doubao-vision）
VOLC_VISION_MODEL_ID=ep-xxxxxxxx

# 深度思考文案模型（方舟平台 DeepSeek 接入点，与 VOLC_API_KEY 共用）
VOLC_REASON_MODEL_ID=ep-xxxxxxxx

# 文生图模型接入点（豆包 Seedream，下酒菜/调酒效果图）
VOLC_IMAGE_MODEL_ID=ep-xxxxxxxx

# 生图尺寸，可选 512x512（更快）或 768x768（默认）
# VOLC_IMAGE_SIZE=768x768

# 若未配置 VOLC_REASON_MODEL_ID，可退回普通文本模型生成方案
# VOLC_TEXT_MODEL_ID=ep-xxxxxxxx

# 若未单独配置上面各项，可只填此项
# VOLC_MODEL_ID=ep-xxxxxxxx

PORT=3000
