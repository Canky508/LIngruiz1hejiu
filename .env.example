# 火山引擎方舟 API Key（控制台 → API Key 管理）
VOLC_API_KEY=your-ark-api-key

# 识酒视觉模型接入点（须支持 image_url 多模态，如 Doubao-vision）
VOLC_VISION_MODEL_ID=ep-xxxxxxxx

# 文本方案生成模型接入点（可与视觉相同或单独配置）
VOLC_TEXT_MODEL_ID=ep-xxxxxxxx

# 文生图模型接入点（火山方舟 Seedream，如 doubao-seedream-4-0 或 ep-xxxxxxxx）
VOLC_IMAGE_MODEL_ID=ep-xxxxxxxx

# 若未单独配置上面各项，可只填此项（识酒、方案、生图共用同一接入点——生图须支持 images/generations）
# VOLC_MODEL_ID=ep-xxxxxxxx

PORT=3000
